// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                   String   @id @default(uuid())
  fullName             String
  yearOfStudy          String
  fieldMajor           String
  linkedinProfile      String?
  telegramUsername     String
  confirmStay          String
  hoursPerWeek         String
  aiLevel              String
  toolsTechnologies    String[] // Array of strings for PostgreSQL
  interests            String[] // Array of strings for PostgreSQL
  preferredTeammates   String?
  avoidTeammates       String?
  whyJoin              String
  yearGoals            String
  hasProjectExperience String
  projectDescription   String?
  chatMessages         Json     // Store the Step 7 conversation transcript
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}